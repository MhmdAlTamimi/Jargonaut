{
  "manifest_version": 3,
  "name": "Jargonaut",
  "version": "0.1.0",
  "description": "Your own definitions of domain terms and abbreviations, right where you read papers.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open your Jargonaut glossary",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "glossary/glossary.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "contextMenus",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "shared/text.js",
        "shared/matcher.js",
        "shared/abbreviations.js",
        "shared/store.js",
        "content/card.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "file:///*"
      ],
      "js": [
        "content/pdf-file.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "lookup-selection": {
      "suggested_key": {
        "default": "Alt+Shift+G"
      },
      "description": "Look up or add the selected text"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdfjs/web/viewer.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "jargonaut@mhmdaltamimi",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
