{
  "manifest_version": 3,
  "name": "Jargonaut",
  "version": "0.1.0",
  "description": "Your own definitions of domain terms and abbreviations, right where you read papers.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open your Jargonaut glossary",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "glossary/glossary.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "shared/text.js",
        "shared/matcher.js",
        "shared/store.js",
        "content/card.js",
        "content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "lookup-selection": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Look up or add the selected text"
    }
  }
}
